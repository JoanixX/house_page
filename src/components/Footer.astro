---
const now = new Date();
---

<footer class="site-footer">
	<div class="mandala-left"></div>
	<div class="mandala-right"></div>
	<div class="footer-top">
		<div class="container footer-top-inner">
			<nav class="footer-menu">
				<a class="reveal hover-lift" href="/policies">Políticas</a>
				<a class="reveal hover-lift" href="/nearbyRestaurants">Restaurantes cercanos</a>
				<a class="reveal hover-lift" href="/events">Eventos</a>
				<a class="reveal hover-lift" href="/experiences">Experiencias</a>
			</nav>
		</div>
	</div>

	<div class="footer-main">
		<div class="container footer-main-inner">
			<div class="footer-columns">
				<div class="col">
					<h5>Medios</h5>
					<a class="reveal hover-lift" href="/media">Videogalería</a>
					<a class="reveal hover-lift" href="/media">Fotogalería</a>
				</div>

				<div class="col">
					<h5>Información</h5>
					<a class="reveal hover-lift" href="/info">Mapa detallado</a>
					<a class="reveal hover-lift" href="/info">Contacto</a>
				</div>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="container footer-bottom-inner">
			<div class="copyright">© {now.getFullYear()} House Page</div>
		</div>
	</div>
</footer>
