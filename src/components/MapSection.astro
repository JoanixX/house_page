---
import SectionImageText from './SectionImageText.astro'
---

<!-- MapSection: wrapper for the map block. Keeps content centralized so index stays clean -->
<div class="map-header">
  <div class="container">
    <div class="map-title">
      <h2>Descansar y relajarse</h2>
      <p class="map-sub">...</p>
    </div>
  </div>
</div>
<div class="map-wrapper">
  <section class="section section-image-text map-explicit">
    <div class="container">
      <div class="img">
        <img src="/images/map.jpg" alt="Mapa del refugio" />
      </div>
      <div class="copy">
        <div class="card">
          <p>...</p>
        </div>
        <div class="card">
          <p>...</p>
        </div>
      </div>
    </div>
  </section>
</div>