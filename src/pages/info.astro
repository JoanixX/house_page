---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <title slot="head">Información — House Page</title>

  <Header siteTitle="House Page" />
  <main>
    <section class="section">
      <div class="container">
        <h2 class="map-title">Contacto e indicaciones</h2>
        <p>Teléfono de contacto: <strong>+51 997 392 467</strong></p>
        <p>Email: <a href="mailto:alvaradocjosorio@gmail.com">alvaradocjosorio@gmail.com</a></p>

        <h3>Cómo llegar</h3>
        <p>(Reemplaza por el mapa embebido o imagen con instrucciones)</p>

        <div class="map-embed">
          <iframe 
            src="..." 
            width="100%" 
            height="450" 
            style="border:0;border-radius:8px;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
