---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const activities = [
  { 
    name: '...', 
    score: 5, 
    desc: '...' 
  },
  { 
    name: '...', 
    score: 5, 
    desc: '...' 
  },
  { 
    name: '...', 
    score: 5, 
    desc: '...' 
  },
  { 
    name: '...', 
    score: 5, 
    desc: '...' 
  },
  { 
    name: '...', 
    score: 5, 
    desc: '...' 
  },
  { 
    name: '...', 
    score: 5, 
    desc: '...' 
  }
];
---

<BaseLayout>
  <title slot="head">Experiencias y Actividades — House Page</title>

  <Header siteTitle="House Page" />

  <main>
    <section class="section">
      <div class="container">
        <h2 class="map-title">Experiencias y actividades</h2>
        <p class="text">Descubre algunas de las actividades más populares que puedes realizar en los alrededores de Refugio Pradreras.</p>

        <div class="activities-grid">
          {activities.map((a, i) => (
            <article class="activity-card" data-i={i}>
              <div class="activity-card-inner">
                <h3 class="activity-title">{a.name}</h3>

                <div class="activity-meta">
                  <div 
                    class="stars" 
                    style={`--pct:${(a.score/5*100).toFixed(2)}%`} 
                    aria-hidden="true"
                  >
                    ★★★★★
                  </div>
                  <div class="rating-number">{a.score.toFixed(1)}</div>
                </div>

                <p class="activity-desc">{a.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>